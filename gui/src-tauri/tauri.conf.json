{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DIAspeXtract",
  "mainBinaryName": "diaspextract-gui",
  "version": "1.9.2",
  "identifier": "de.openms.diaspextract",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "DIAspeXtract", "width": 1180, "height": 860, "minWidth": 760, "minHeight": 560 }],
    "security": { "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:" }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "nsis", "deb"],
    "resources": { "resources/diaspextract/": "diaspextract/" },
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "category": "Utility",
    "shortDescription": "Pseudo-MS/MS spectra from DIA data",
    "copyright": "Copyright (c) 2026 Oliver Kohlbacher and contributors",
    "license": "BSD-3-Clause",
    "macOS": { "minimumSystemVersion": "15.0" },
    "linux": { "deb": { "depends": [] } }
  }
}
