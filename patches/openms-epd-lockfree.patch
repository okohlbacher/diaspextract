+    const int frame_len = std::max(3, win_size); // must exceed polynomial_order, or SG throws
+    static thread_local std::unordered_map<int, SavitzkyGolayFilter> sg_cache;
+    auto sg_it = sg_cache.find(frame_len);
+    if (sg_it == sg_cache.end())
+    {
+      Param param;
+      param.setValue("polynomial_order", 2);
+      param.setValue("frame_length", frame_len);
+      sg_it = sg_cache.emplace(std::piecewise_construct, std::forward_as_tuple(frame_len),
+                               std::forward_as_tuple()).first;
+      sg_it->second.setParameters(param);
+    }
+    SavitzkyGolayFilter& sg = sg_it->second;
     sg.filter(spectrum);
     MSSpectrum::iterator iter = spectrum.begin();
     std::vector<double> smoothed_intensities;
