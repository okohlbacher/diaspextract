+    // The per-trace path keeps the original expression.
+    Size win_size = scan_time_ > 0.0 ? (Size)std::ceil(chrom_fwhm_ / scan_time - 1e-6) : (Size)std::ceil(chrom_fwhm_ / scan_time);
 
