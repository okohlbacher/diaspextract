     MSSpectrum spectrum;
+    spectrum.reserve(mt.getSize());
     for (Size i = 0; i != mt.getSize(); ++i)
     {
       spectrum.push_back(Peak1D(mt[i].getRT(), mt[i].getIntensity()));
