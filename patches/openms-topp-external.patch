# DIAspeXtract: getDocumentationURL() overridable, for a TOPP tool outside the OpenMS release.
# It returns http://www.openms.de/doxygen/<nightly|release>/html/TOPP_<tool>.html and is not virtual. For DIAspeXtract
# that page does not exist, so the first line of --help pointed at a 404. One word makes it overridable; the tool
# returns its repository. (The second fix this patch carried for OpenMS 3.6, CTD/CWL for an unregistered tool, is
# upstream: ToolHandler::getTypes returns no types for it.)
# ABI: the new virtual sits before other virtuals in TOPPBase, so it shifts their vtable slots. Never run a binary built
# against UNPATCHED OpenMS headers with this libOpenMS.
--- a/src/openms_cli/include/OpenMS/APPLICATIONS/TOPPBase.h
+++ b/src/openms_cli/include/OpenMS/APPLICATIONS/TOPPBase.h
@@ -130,7 +130,9 @@ public:
     std::string getToolPrefix() const;
 
     /// Returns a link to the documentation of the tool (accessible on our servers and only after inclusion in the nightly branch or a release).
-    std::string getDocumentationURL() const;
+    /// Virtual so that a tool outside the OpenMS release can point --help and its CTD at its own documentation:
+    /// the default URL is the OpenMS documentation page of the tool, which does not exist for it.
+    virtual std::string getDocumentationURL() const;
 
     /// The latest and greatest OpenMS citation
     static const Citation cite_openms;
