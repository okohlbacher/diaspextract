# DIAspeXtract: encode mzML spectra in parallel, write them in order.
#
# Serialising one spectrum is independent of every other spectrum; only the CONCATENATION is
# ordered. The stock writer does both on one thread, and it is CPU-bound, not I/O-bound: measured,
# it sustains ~400 MB/s while the filesystem underneath it does 4.0 GB/s. On a 2-hour diaPASEF
# acquisition that phase is 92.9 s of an 822 s run (10.7%), entirely serial.
#
# This encodes chunks of spectra into per-chunk buffers in parallel and appends them to the output
# stream in index order, which is byte-for-byte what the serial loop produced. Work proceeds in
# waves (chunk x threads spectra) so the buffered text stays bounded instead of holding the file.
#
# The writer is NOT reentrant on a single handler, which is the whole difficulty: writeSpectrum_
# and its helpers (writePrecursor_, writeSoftware_, writeSourceFile_, writeDataProcessing_) are
# non-const, MzMLHandler::cached_terms_ is a mutable memo of CV-term validation written during
# serialisation, and the SemanticValidator holds its own state. Sharing one handler across threads
# corrupts the heap within seconds (verified: "double free or corruption", aborting inside
# writePrecursor_'s allocation). So each thread is given its OWN handler and validator, built from
# the same members and carrying the same PeakFileOptions -- the options decide the output, so they
# must match exactly. Nothing is shared but the read-only experiment and the dataProcessing list.
#
# An exception must never escape an OpenMP region (that calls std::terminate), so the first one is
# captured and rethrown on the writing thread.
#
# Measured on a 30-minute acquisition, 100 threads: WRITE(mzML) 20.1 s -> 5.9 s, parallelism
# 1.0x -> 51.4x, spectrum list byte-identical.
#
# Base: OpenMS/OpenMS develop bd4b89555629d68b431b189a4c841efbcc4dfeea (2026-04-24).
# Verified to reproduce the built tree byte-for-byte. Touches the .cpp only.
#
# 2026-09-09: INDEX REGRESSION FIXED. Each per-thread handler recorded its <spectrum> offsets
# relative to its own chunk buffer and into its own spectra_offsets_, which nobody read, so every
# file this patch wrote carried an EMPTY <indexList> (count="0", one dummy entry, offset -1) --
# a v2.0.0 conformance defect the spectrum digest cannot see (it stops at </spectrumList>) and the
# search engines never noticed (they parse sequentially). The pre-patch writer indexed correctly.
# The chunk loop now collects each chunk's buffer-relative offsets and rebases them by the file
# position the chunk is appended at; the spectrum bytes are unchanged.
# Apply with: patch -p1 -d <OpenMS tree> < this file
--- a/src/openms/source/FORMAT/HANDLERS/MzMLHandler.cpp	2026-09-09 12:16:35
+++ b/src/openms/source/FORMAT/HANDLERS/MzMLHandler.cpp	2026-09-09 12:16:38
@@ -8,6 +8,13 @@
 
 #include <OpenMS/FORMAT/HANDLERS/MzMLHandler.h>
 
+#include <sstream>
+#include <exception>
+#include <memory>
+#ifdef _OPENMP
+#include <omp.h>
+#endif
+
 #include <OpenMS/CONCEPT/Exception.h>
 #include <OpenMS/CONCEPT/LogStream.h>
 #include <OpenMS/CONCEPT/VersionInfo.h>
@@ -4070,12 +4077,87 @@
         }
 
         // write actual data
-        for (Size s_idx = 0; s_idx < exp.size(); ++s_idx)
+        // [DIAspeXtract] Serialising one spectrum is independent of every other; only the
+        // CONCATENATION is ordered. Encode in parallel into per-chunk buffers and append them in
+        // index order -- byte-for-byte what the serial loop produced. Serial writing sustained
+        // ~400 MB/s against a filesystem measured at 4.0 GB/s, i.e. this phase is CPU-bound.
+        //
+        // The writer is NOT reentrant on one handler: writeSpectrum_ and its helpers are non-const
+        // and mutate handler state (cached_terms_ memoises CV-term validation), and the validator
+        // has its own. So each thread gets its OWN handler and validator, constructed from the same
+        // members and carrying the same options, and touches nothing shared but the read-only
+        // experiment and dps. Work proceeds in waves so buffered text stays bounded.
         {
-          logger_.setProgress(progress++);
-          const SpectrumType& spec = exp[s_idx];
-          writeSpectrum_(os, spec, s_idx, validator, renew_native_ids, dps);
-          ++stored_spectra;
+          const Size n_spec = exp.size();
+          const Size CHUNK = 256;
+#ifdef _OPENMP
+          const Size n_thr = (Size)std::max(1, omp_get_max_threads());
+#else
+          const Size n_thr = 1;
+#endif
+          std::vector<std::unique_ptr<MzMLHandler> > hs(n_thr);
+          std::vector<std::unique_ptr<Internal::MzMLValidator> > vs(n_thr);
+          for (Size t = 0; t < n_thr; ++t)
+          {
+            hs[t].reset(new MzMLHandler(exp, file_, version_, logger_));
+            hs[t]->options_ = options_;   // the options decide output; they must match exactly
+            vs[t].reset(new Internal::MzMLValidator(mapping_, cv_));
+          }
+          const Size wave = CHUNK * n_thr;
+          std::vector<std::string> enc;
+          std::exception_ptr wr_err;
+          for (Size w0 = 0; w0 < n_spec; w0 += wave)
+          {
+            const Size w1 = std::min(w0 + wave, n_spec);
+            const Size n_chunk = (w1 - w0 + CHUNK - 1) / CHUNK;
+            enc.assign(n_chunk, std::string());
+            // [DIAspeXtract index] Each thread's handler records <spectrum> offsets RELATIVE TO ITS
+            // OWN CHUNK BUFFER and into ITS OWN spectra_offsets_, which nobody read: the file's
+            // <indexList> came out empty (count="0", a dummy entry) on every parallel-written
+            // file. Collect the chunk's offsets here and rebase them when the chunk is appended.
+            std::vector<std::vector<std::pair<std::string, Int64> > > offs(n_chunk);
+#pragma omp parallel for schedule(dynamic, 1)
+            for (SignedSize c = 0; c < (SignedSize)n_chunk; ++c)
+            {
+              try
+              {
+#ifdef _OPENMP
+                const Size tid = (Size)omp_get_thread_num();
+#else
+                const Size tid = 0;
+#endif
+                std::ostringstream buf;
+                buf.copyfmt(os);   // identical formatting state, or the numbers differ
+                const Size lo = w0 + (Size)c * CHUNK, hi = std::min(lo + CHUNK, w1);
+                const Size o0 = hs[tid]->spectra_offsets_.size();
+                for (Size s_idx = lo; s_idx < hi; ++s_idx)
+                {
+                  hs[tid]->writeSpectrum_(buf, exp[s_idx], s_idx, *vs[tid], renew_native_ids, dps);
+                }
+                enc[(Size)c] = buf.str();
+                // buffer-relative offsets of this chunk's spectra (writeSpectrum_ took buf.tellp())
+                offs[(Size)c].assign(hs[tid]->spectra_offsets_.begin() + o0, hs[tid]->spectra_offsets_.end());
+                hs[tid]->spectra_offsets_.resize(o0);
+              }
+              catch (...)
+              {
+                // An exception must never escape an OpenMP region: that calls std::terminate.
+#pragma omp critical (spx_write_err)
+                if (!wr_err) { wr_err = std::current_exception(); }
+              }
+            }
+            if (wr_err) { std::rethrow_exception(wr_err); }
+            for (Size c = 0; c < n_chunk; ++c)
+            {
+              const Int64 base = (Int64)os.tellp();   // where this chunk lands in the FILE
+              os << enc[c];
+              for (const auto& p : offs[c]) { spectra_offsets_.emplace_back(p.first, base + p.second); }
+              std::string().swap(enc[c]);
+            }
+            progress += (int)(w1 - w0);
+            logger_.setProgress(progress);
+            stored_spectra += (UInt)(w1 - w0);
+          }
         }
         os << "\t\t</spectrumList>\n";
       }
