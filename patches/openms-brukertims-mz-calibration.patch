+// [DIAspeXtract table-mz] License-free EXACT TOF->m/z from the TDF MzCalibration table.
+// The MODEL lives in DIAspeXtract's own repo (src/TdfMzCalibration.h, BSD-3, copied here by
+// scripts/apply_openms_patches.sh) so the shipped code is the code the C++ unit test exercises.
+// Fails CLOSED: an unsupported calibration (ModelType != 1, dC2 != 0, multi-row table) throws
+// rather than silently using the -5..-11 ppm chord. DIASPEXTRACT_ALLOW_CHORD_FALLBACK=1 opts back in.
+#include <sqlite3.h>
+#include <OpenMS/FORMAT/TdfMzCalibration.h>
+namespace {
+// File-local (never crosses a DSO boundary, unlike an inline header static): which m/z
+// calibration the last load used. Stamped onto the MSExperiment so it travels with the data.
+std::string g_mz_calibration = "unset";
+// [DIAspeXtract frame-table] the last streamed run's DIA frame table and windows (see the header)
+std::map<int, std::vector<BrukerTimsFile::DIAFrameRow>> g_dia_frame_table;
+std::vector<BrukerTimsFile::DIAWindowRow> g_dia_windows;
+class TdfTableTof2MzConverter final : public Tof2MzConverter
+{
+  diaspextract::TdfMzCalibration cal_;
+  std::vector<double> frame_t1_;
+public:
+  explicit TdfTableTof2MzConverter(const std::string& d_dir)
+  {
+    const std::string tdf = d_dir + "/analysis.tdf";
+    sqlite3* db = nullptr;
+    if (sqlite3_open_v2(tdf.c_str(), &db, SQLITE_OPEN_READONLY, nullptr) != SQLITE_OK)
+    {
+      const std::string why = db ? sqlite3_errmsg(db) : "out of memory";
+      sqlite3_close(db);   // sqlite allocates the handle even on failure
+      throw std::runtime_error("TdfMzCalibration: cannot open " + tdf + ": " + why);
+    }
+    // Use the calibration row the FRAMES reference (Frames.MzCalibration), not "the only row".
+    // A tdf may carry more than one MzCalibration row -- the public PXD017703 HeLa acquisitions
+    // have two, of which every frame references Id 1 -- so "expected exactly 1" refused valid
+    // data. Refuse only when the frames reference more than one row, which would need a
+    // per-frame calibration this converter does not implement.
+    // A Frames table without the MzCalibration column (a minimal or very old tdf) falls back to the single-row rule, as
+    // the tool's own reader does: unambiguous only if MzCalibration has exactly one row.
+    sqlite3_stmt* st = nullptr;
+    bool frames_have_cal = false;
+    if (sqlite3_prepare_v2(db, "PRAGMA table_xinfo(Frames)", -1, &st, nullptr) == SQLITE_OK)
+      while (sqlite3_step(st) == SQLITE_ROW)
+      { const unsigned char* c = sqlite3_column_text(st, 1); frames_have_cal = frames_have_cal || (c && sqlite3_stricmp(reinterpret_cast<const char*>(c), "MzCalibration") == 0); }
+    sqlite3_finalize(st); st = nullptr;
+    long long cal_id = -1; int ncal = 0;
+    if (sqlite3_prepare_v2(db, frames_have_cal ? "SELECT DISTINCT MzCalibration FROM Frames" : "SELECT Id FROM MzCalibration", -1, &st, nullptr) == SQLITE_OK)
+      while (sqlite3_step(st) == SQLITE_ROW) { cal_id = sqlite3_column_int64(st, 0); ++ncal; }
+    sqlite3_finalize(st); st = nullptr;
+    if (ncal != 1)
+    { sqlite3_close(db); throw std::runtime_error(frames_have_cal
+        ? "TdfMzCalibration: frames reference " + std::to_string(ncal) + " distinct MzCalibration rows, expected exactly 1 (per-frame recalibration is not supported)"
+        : "TdfMzCalibration: Frames has no MzCalibration column and MzCalibration has " + std::to_string(ncal) + " rows (need exactly 1)"); }
+    if (sqlite3_prepare_v2(db,
+          "SELECT ModelType, DigitizerTimebase, DigitizerDelay, C0, C1, C2, T1, dC1, dC2, C3, C4 "
+          "FROM MzCalibration WHERE Id = ?", -1, &st, nullptr) == SQLITE_OK
+        && sqlite3_bind_int64(st, 1, cal_id) == SQLITE_OK
+        && sqlite3_step(st) == SQLITE_ROW)
+    {
+      for (int col = 0; col <= 10; ++col)
+      {
+        const int ct = sqlite3_column_type(st, col);
+        if (ct != SQLITE_INTEGER && ct != SQLITE_FLOAT)
+        { sqlite3_finalize(st); sqlite3_close(db);
+          throw std::runtime_error("TdfMzCalibration: MzCalibration column " + std::to_string(col)
+                                   + " is NULL or non-numeric"); }
+      }
+      cal_.model_type = sqlite3_column_int(st, 0);
+      cal_.digitizer_timebase = sqlite3_column_double(st, 1);
+      cal_.digitizer_delay = sqlite3_column_double(st, 2);
+      cal_.C0 = sqlite3_column_double(st, 3); cal_.C1 = sqlite3_column_double(st, 4);
+      cal_.C2 = sqlite3_column_double(st, 5); cal_.T1_ref = sqlite3_column_double(st, 6);
+      cal_.dC1 = sqlite3_column_double(st, 7); cal_.dC2 = sqlite3_column_double(st, 8);
+      cal_.C3 = sqlite3_column_double(st, 9);  cal_.C4 = sqlite3_column_double(st, 10);
+    }
+    sqlite3_finalize(st); st = nullptr;
+    if (!cal_.isSupported())
+    { const std::string why = cal_.unsupportedReason(); sqlite3_close(db); throw std::runtime_error("TdfMzCalibration: " + why); }
+    if (sqlite3_prepare_v2(db, "SELECT Id, T1 FROM Frames", -1, &st, nullptr) != SQLITE_OK)
+    { sqlite3_close(db); throw std::runtime_error("TdfMzCalibration: cannot read Frames.T1"); }
+    {
+      int rc;
+      while ((rc = sqlite3_step(st)) == SQLITE_ROW)
+      {
+        const size_t id = (size_t)sqlite3_column_int64(st, 0);
+        if (id > 100000000u)   // sparse/corrupt frame ids must not drive an unbounded resize
+        { sqlite3_finalize(st); sqlite3_close(db); throw std::runtime_error("TdfMzCalibration: implausible Frames.Id " + std::to_string(id)); }
+        if (id >= frame_t1_.size()) frame_t1_.resize(id + 1, cal_.T1_ref);
+        // A NULL T1 reads as 0.0 through sqlite3_column_double, which would silently apply the FULL
+        // dC1*T1_ref temperature correction (~250 ppm) instead of none. Fall back to the reference
+        // temperature (= no correction) rather than inventing one.
+        const int t1_type = sqlite3_column_type(st, 1);
+        if (t1_type != SQLITE_NULL && t1_type != SQLITE_INTEGER && t1_type != SQLITE_FLOAT)   // TEXT would read as 0 C
+        { sqlite3_finalize(st); sqlite3_close(db); throw std::runtime_error("TdfMzCalibration: frame " + std::to_string(id) + ": Frames.T1 is not a number"); }
+        frame_t1_[id] = (t1_type == SQLITE_NULL) ? cal_.T1_ref : sqlite3_column_double(st, 1);
+      }
+      if (rc != SQLITE_DONE)   // a partial read would silently leave frames at T1_ref
+      { sqlite3_finalize(st); sqlite3_close(db);
+        throw std::runtime_error("TdfMzCalibration: Frames.T1 read ended early (sqlite rc "
+                                 + std::to_string(rc) + ")"); }
+    }
+    sqlite3_finalize(st);
+    sqlite3_close(db);
+  }
+  // frame_id 0 is not a real Bruker frame (Frames.Id is 1-based); one pristine OpenMS DDA path
+  // converts with a hardcoded 0. Slot 0 therefore holds T1_ref by construction = no temperature
+  // correction (<=0.7 ppm on the files measured). Documented rather than incidental.
+  inline double b_(uint32_t frame_id) const
+  { return cal_.frameFactor(frame_id < frame_t1_.size() ? frame_t1_[frame_id] : cal_.T1_ref); }
+  void convert(uint32_t frame_id, double* mzs, const double* tofs, uint32_t size) override final
+  { const double b = b_(frame_id); for (uint32_t i = 0; i < size; ++i) mzs[i] = cal_.tofToMz(tofs[i], b); }
+  void convert(uint32_t frame_id, double* mzs, const uint32_t* tofs, uint32_t size) override final
+  { const double b = b_(frame_id); for (uint32_t i = 0; i < size; ++i) mzs[i] = cal_.tofToMz((double)tofs[i], b); }
+  void inverse_convert(uint32_t frame_id, uint32_t* tofs, const double* mzs, uint32_t size) override final
+  { const double b = b_(frame_id);
+    for (uint32_t i = 0; i < size; ++i) tofs[i] = (uint32_t)std::max(0.0, std::round(cal_.mzToTof(mzs[i], b))); }
+  std::string description() override final { return "TdfMzCalibration (ModelType 1 + temperature, exact)"; }
+};
