# EXAMPLE driver. Copy without .example and fill in real paths.
# The working copy is untracked: it names acquisitions and specimens.
#!/usr/bin/env bash
# Entrapment-controlled OPEN-search benchmark.
#
# The closed benchmark that produced every number in README.md cannot see the failure mode this
# tool exists to avoid: a charge error fabricates dM = (z'-z)(m/z - 1.00728), hundreds of Da, and
# a +-25 ppm search simply does not report those PSMs. This measures in the mode the tool is for.
#
# Arms, all on dataset_B, all from EXISTING mzML (no re-extraction -- the spectra are already produced):
#   base         ms1_split_valleys 0,   charge:scoring envelope   (the pre-2026-07-21 default)
#   split_count  ms1_split_valleys 7.0, charge:scoring count      (the shipped default)
#   envelope     ms1_split_valleys 7.0, charge:scoring envelope   (POSITIVE CONTROL: 10,199 known
#                                                                  4->2 errors must show as
#                                                                  slope -2 ray mass)
#
# Two windows: -150/+500 Da for the primary metric, -3000/+1000 for the positive control, because
# a 4->2 error at m/z 500-1400 lands at -1000 to -2800 Da and is NOT REPORTED inside +-500.
set -u
cd /path/to/scratch/bench
B=/path/to/scratch/bench
SAGE=$B/sage-v0.14.7-x86_64-unknown-linux-gnu/sage
L=$B/open_bench.log
echo "=== entrapment open-search benchmark $(date) ===" > $L

# ---- entrapment database ----------------------------------------------------------------------
ENTRAP=$B/human_entrap.fasta
if [ ! -s "$ENTRAP" ]; then
  python3 $B/open_bench.py fasta --target $B/human.fasta --foreign $B/arabidopsis.fasta \
      --out "$ENTRAP" >> $L 2>&1
fi
NT=$(grep -c "^>" $B/human.fasta)
NE=$(grep -c "^>ENTRAP_" "$ENTRAP")
RATIO=$(python3 -c "print(%.6f % ($NE/$NT))" 2>/dev/null || python3 -c "print($NE/$NT)")
echo "entrapment: $NT target / $NE foreign, ratio $RATIO" >> $L

# ---- arms: reuse mzML already produced --------------------------------------------------------
# All three arms must come from ONE node and ONE binary. base and envelope already exist here;
# split_count exists only on one node, from a different binary. Comparing across nodes/binaries is
# precisely the error class this benchmark was built to eliminate, so it is re-extracted here
# rather than copied.
TOOL=/path/to/scratch/OpenMS/build/bin/diaspextract
DD=/path/to/scratch/rawd/<acquisition-B>
COMMON="-trace:ms2_chrom_peak_snr 1.0 -trace:ms2_noise_threshold_int 10 -trace:ms2_min_length_sec 0 -trace:ms2_split_valleys 7.0"
SC=$B/out/open_split_count
if [ ! -s "$SC/pseudo.mzML" ]; then
  mkdir -p "$SC"
  echo "extracting split_count on this node (same binary as base/envelope) $(date)" >> $L
  LD_PRELOAD=/usr/lib/x86_64-linux-gnu/libtcmalloc_minimal.so.4 \
  LD_LIBRARY_PATH=/path/to/scratch/OpenMS/build/lib \
    $TOOL -in "$DD" -out "$SC/pseudo.mzML" -threads 120 $COMMON \
      -trace:ms1_split_valleys 7.0 -charge:scoring count > "$SC/run.log" 2>&1
  echo "  extraction done $(date)" >> $L
fi

declare -A MZ
MZ[base]=$B/out/m_<dataset-B>_base/pseudo.mzML
MZ[split_count]=$SC/pseudo.mzML
MZ[envelope]=$B/out/way2_both/pseudo.mzML

run_one () {
  local ARM=$1 CFG=$2 WIN=$3
  local SRC=${MZ[$ARM]}
  local O=$B/open/${ARM}_${WIN}
  if [ ! -s "$SRC" ]; then echo "[$ARM/$WIN] SKIP: no mzML at $SRC" >> $L; return; fi
  mkdir -p "$O"
  # point the version-controlled config at the entrapment database
  python3 - "$CFG" "$ENTRAP" "$O/sage.json" <<'PY'
import json, sys
c = json.load(open(sys.argv[1]))
c["database"]["fasta"] = sys.argv[2]
json.dump(c, open(sys.argv[3], "w"), indent=2)
PY
  local t0=$SECONDS
  LD_PRELOAD=/usr/lib/x86_64-linux-gnu/libtcmalloc_minimal.so.4 \
    "$SAGE" "$O/sage.json" -o "$O" --disable-telemetry-i-dont-want-to-improve-sage \
    "$SRC" > "$O/sage.log" 2>&1
  if [ ! -s "$O/results.sage.tsv" ]; then
    echo "[$ARM/$WIN] SAGE FAILED after $((SECONDS-t0))s" >> $L
    tail -3 "$O/sage.log" >> $L
    return
  fi
  echo "--- $ARM / $WIN  ($((SECONDS-t0))s)" >> $L
  python3 $B/open_bench.py analyse "$O/results.sage.tsv" --label "${ARM}_${WIN}" \
      --ratio "$RATIO" --json $B/open/results.json >> $L 2>&1
}

mkdir -p $B/open
for ARM in base split_count envelope; do
  run_one "$ARM" "$B/sage_open.json" w500
done
# positive control only: the wide window is expensive and its FDR is less trustworthy
run_one envelope    "$B/sage_open_wide.json" wide
run_one split_count "$B/sage_open_wide.json" wide

echo DONE >> $L
