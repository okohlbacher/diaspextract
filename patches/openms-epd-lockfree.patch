     defaults_.setValue("masstrace_snr_filtering", "false", "Apply post-filtering by signal-to-noise ratio after smoothing.", {"advanced"});
     defaults_.setValidStrings("masstrace_snr_filtering", {"true","false"});
+    // [DIAspeXtract] The smoothing window is chrom_fwhm / scan time. Derived from the trace's own
+    // points, the scan time of a trace with gaps is inflated by the gaps (the caller may hand over
+    // real points only), so a long, gappy trace gets a NARROWER window than its neighbours and a
+    // sub-range of it is smoothed differently from the whole -- the split is then a function of
+    // where the trace was cut. A caller that knows the acquisition's frame spacing sets it here.
+    defaults_.setValue("scan_time", 0.0, "Scan (cycle) time in seconds used to convert chrom_fwhm into the smoothing window. 0 = derive it from each mass trace's own average cycle time.", {"advanced"});
 
     defaultsToParam_();
     this->setLogType(CMD);
