# EXAMPLE driver. Copy without .example and fill in real paths.
# The working copy is untracked: it names acquisitions and specimens.
#!/usr/bin/env bash
# Joint benchmark: 3 samples x {the reference implementation, DIAspeXtract} x {Sage, MSFragger}
# Metrics: FDR-corrected PSMs and FDR-corrected unique peptides, both at 1%, both computed by
# ONE procedure in joint_bench.py so the engine is the only thing that varies.
#
# Both engines search ONE pre-built target+decoy database (Sage's internal decoy generation is
# OFF), so they see byte-identical search spaces. Search parameters are matched to
# sage_closed.json -- the config behind every number in the README.
set -u
B=/path/to/scratch/bench
cd $B
SAGE=$B/sage-v0.14.7-x86_64-unknown-linux-gnu/sage
MSF=/path/to/fp-tools/MSFragger-4.4.1.jar
DTP=/path/to/mzml-reference-patched
L=$B/joint.log
J=$B/joint_results.json
echo "=== joint benchmark $(date) ===" > $L

# do not contend with the open-search benchmark on this node
while pgrep -f "run_open" >/dev/null 2>&1; do sleep 60; done

# ---- shared target+decoy database --------------------------------------------------------------
DB=$B/human_decoy.fasta
[ -s "$DB" ] || python3 $B/joint_bench.py decoydb --target $B/human.fasta --out "$DB" >> $L 2>&1
grep -c "^>rev_" "$DB" | xargs echo "decoys in shared DB:" >> $L

# ---- Sage config: same as closed, but decoys come from the FILE --------------------------------
python3 - "$B/sage_closed.json" "$DB" "$B/sage_joint.json" <<'PY'
import json, sys
c = json.load(open(sys.argv[1]))
c["database"]["fasta"] = sys.argv[2]
c["database"]["generate_decoys"] = False      # decoys are in the shared file
c["database"]["decoy_tag"] = "rev_"
json.dump(c, open(sys.argv[3], "w"), indent=2)
PY

# ---- MSFragger params, matched to sage_closed.json ---------------------------------------------
cat > $B/msfragger.params <<EOF
database_name = $DB
decoy_prefix = rev_
num_threads = 100
precursor_mass_lower = -25
precursor_mass_upper = 25
precursor_mass_units = 1
precursor_true_tolerance = 25
precursor_true_units = 1
fragment_mass_tolerance = 25
fragment_mass_units = 1
isotope_error = -1/0/1/2
search_enzyme_name_1 = trypsin
search_enzyme_cut_1 = KR
search_enzyme_nocut_1 = P
allowed_missed_cleavage_1 = 2
num_enzyme_termini = 2
digest_min_length = 7
digest_max_length = 35
digest_mass_range = 500.0 5000.0
max_variable_mods_per_peptide = 2
variable_mod_01 = 15.9949 M 3
variable_mod_02 = 42.0106 [^ 1
add_C_cysteine = 57.02146
precursor_charge = 2 4
override_charge = 0
output_format = tsv
output_report_topN = 1
output_max_expect = 50
minimum_peaks = 6
min_matched_fragments = 4
use_topN_peaks = 150
EOF

run_cell () {
  local TOOL=$1 SAMPLE=$2 MZ=$3
  if [ ! -s "$MZ" ]; then echo "[$TOOL/$SAMPLE] SKIP: missing $MZ" >> $L; return; fi

  # ---- Sage ----
  local O=$B/joint/${TOOL}_${SAMPLE}_sage; mkdir -p $O
  if [ ! -s "$O/results.sage.tsv" ]; then
    local t0=$SECONDS
    LD_PRELOAD=/usr/lib/x86_64-linux-gnu/libtcmalloc_minimal.so.4 \
      $SAGE $B/sage_joint.json -o $O --disable-telemetry-i-dont-want-to-improve-sage \
      "$MZ" > $O/engine.log 2>&1
    echo "[$TOOL/$SAMPLE] sage $((SECONDS-t0))s" >> $L
  fi
  [ -s "$O/results.sage.tsv" ] \
    && python3 $B/joint_bench.py score "$O/results.sage.tsv" --engine sage \
         --label "${TOOL}_${SAMPLE}" --json $J >> $L 2>&1 \
    || { echo "[$TOOL/$SAMPLE] SAGE FAILED" >> $L; tail -3 $O/engine.log >> $L; }

  # ---- MSFragger ----
  local M=$B/joint/${TOOL}_${SAMPLE}_msf; mkdir -p $M
  local TSV=$M/$(basename "${MZ%.*}").tsv
  if [ ! -s "$TSV" ]; then
    local t1=$SECONDS
    ( cd $M && java -Xmx220G -jar $MSF $B/msfragger.params "$MZ" > $M/engine.log 2>&1 )
    echo "[$TOOL/$SAMPLE] msfragger $((SECONDS-t1))s" >> $L
    # MSFragger writes next to the INPUT unless told otherwise -- same trap the reference implementation set
    for f in "$(dirname "$MZ")/$(basename "${MZ%.*}").tsv" "$M"/*.tsv; do
      [ -s "$f" ] && TSV="$f" && break
    done
  fi
  [ -s "$TSV" ] \
    && python3 $B/joint_bench.py score "$TSV" --engine msfragger \
         --label "${TOOL}_${SAMPLE}" --json $J >> $L 2>&1 \
    || { echo "[$TOOL/$SAMPLE] MSFRAGGER FAILED (no tsv)" >> $L; tail -4 $M/engine.log >> $L; }
}

mkdir -p $B/joint
run_cell reference dataset_A "$DTP/<acquisition-A>"
run_cell reference dataset_B "$DTP/<acquisition-B>"
run_cell reference dataset_D "$DTP/<acquisition-D>"
run_cell diaspextract dataset_A "$B/out/m_<dataset-A>_treat/pseudo.mzML"
run_cell diaspextract dataset_B "$B/out/open_split_count/pseudo.mzML"
run_cell diaspextract dataset_D "$B/out/m_<dataset-D>_treat/pseudo.mzML"

echo "--- TABLE ---" >> $L
python3 $B/joint_bench.py collate $J >> $L 2>&1
echo DONE >> $L
