{
  "_comment": [
    "A closed-search Sage config. Set `fasta` to the target FASTA before running.",
    "precursor_tol is +-25 ppm, so a charge error (dM = (z'-z)(m/z - 1.00728), hundreds of Da)",
    "produces no PSM: a closed search cannot see it."
  ],
  "database": {
    "bucket_size": 8192,
    "enzyme": {
      "missed_cleavages": 2,
      "min_len": 7,
      "max_len": 35,
      "cleave_at": "KR",
      "restrict": "P"
    },
    "fragment_min_mz": 150.0,
    "fragment_max_mz": 2000.0,
    "peptide_min_mass": 500.0,
    "peptide_max_mass": 5000.0,
    "ion_kinds": ["b", "y"],
    "min_ion_index": 2,
    "max_variable_mods": 2,
    "static_mods": { "C": 57.02146 },
    "variable_mods": { "M": [15.9949], "^n": [42.0106] },
    "generate_decoys": true,
    "decoy_tag": "rev_",
    "fasta": "PLACEHOLDER_REWRITTEN_AT_RUNTIME"
  },
  "precursor_tol": { "ppm": [-25.0, 25.0] },
  "fragment_tol": { "ppm": [-25.0, 25.0] },
  "precursor_charge": [2, 4],
  "isotope_errors": [-1, 2],
  "deisotope": true,
  "chimera": false,
  "predict_rt": false,
  "min_peaks": 6,
  "min_matched_peaks": 4,
  "max_fragment_charge": 2,
  "report_psms": 1
}
