-    SavitzkyGolayFilter sg;
-    Param param;
-    param.setValue("polynomial_order", 2);
-    param.setValue("frame_length", std::max(3, win_size)); // frame length must be at least polynomial_order+1, otherwise SG will fail
-    sg.setParameters(param);
+    // [DIAspeXtract] The filter coefficients depend only on (frame_length, polynomial_order), but
+    // setParameters() -> updateMembers_() recomputes them with one Eigen SVD per half-window on
+    // EVERY call. smoothData() runs once per mass trace -- hundreds of millions of times on a full
